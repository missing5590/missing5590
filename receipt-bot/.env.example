# Telegram bot tokeni (@BotFather dan olinadi). Faqat serverdagi .env faylga yoziladi, GitHub'ga yuklanmaydi!
BOT_TOKEN=

# ---- Xosting (relay) rejimi: serverga tashqaridan kirib bo'lmasa (tavsiya etiladi) ----
# Tayyor cheklar shu manzilga yuboriladi, 1C ularni o'sha yerdan oladi.
RELAY_URL=https://cheklar.onesoft.uz
# Xostingdagi config.php dagi server_key bilan bir xil
RELAY_KEY=
# Xosting bilan sinxronizatsiya oralig'i (sekund)
RELAY_INTERVAL=30

# ---- To'g'ridan-to'g'ri rejim: 1C shu serverning o'ziga ulanadi ----
# Xosting rejimida bo'sh qoldiring (mahalliy API yopiq bo'ladi).
# Yaratish: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Server manzili va porti (1C shu manzilga ulanadi)
HOST=0.0.0.0
PORT=8090

# Ma'lumotlar papkasi (SQLite baza va chek rasmlari)
DATA_DIR=./data

# Dublikat tekshiruvi: check_number (faqat chek raqami) yoki check_number_fm (chek raqami + fiskal modul)
DEDUP_BY=check_number

# Botdan foydalanishga ruxsat berilgan Telegram chat ID'lari (vergul bilan). Bo'sh bo'lsa - hammaga ruxsat.
ALLOWED_CHAT_IDS=

# ofd.soliq.uz dan ma'lumot olinmasa qayta urinish oralig'i (sekund) va urinishlar soni
RETRY_INTERVAL=600
MAX_FETCH_ATTEMPTS=36

# 1C olgan, lekin tasdiqlamagan (ack) cheklar necha daqiqadan keyin qayta beriladi
LEASE_MINUTES=15
