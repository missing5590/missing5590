[Unit]
Description=Receipt bot (Telegram -> ofd.soliq.uz -> 1C)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=receiptbot
WorkingDirectory=/opt/receipt-bot/receipt-bot
EnvironmentFile=/opt/receipt-bot/receipt-bot/.env
ExecStart=/opt/receipt-bot/receipt-bot/.venv/bin/python -m app.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
