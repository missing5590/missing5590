// Внешняя обработка «Загрузка чеков из Telegram» - модуль основной формы.
// На форме: поля реквизитов объекта, таблица Объект.Результаты, команда «Загрузить».

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Настройки = ХранилищеОбщихНастроек.Загрузить("ЗагрузкаЧековTelegram", "Настройки");
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Объект, Настройки);
	Иначе
		Объект.ПропускатьНулевыеСтроки = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)

	ЗагрузитьНаСервере();

	Создано = 0;
	Ошибок = 0;
	Для Каждого СтрокаРезультата Из Объект.Результаты Цикл
		Если СтрокаРезультата.Результат = "Создан" Тогда
			Создано = Создано + 1;
		ИначеЕсли СтрНачинаетсяС(СтрокаРезультата.Результат, "Ошибка") Тогда
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЦикла;
	ПоказатьОповещениеПользователя("Загрузка чеков завершена", ,
		СтрШаблон("Получено: %1, создано: %2, ошибок: %3", Объект.Результаты.Количество(), Создано, Ошибок));

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНаСервере()

	СохранитьНастройки();
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.ЗагрузитьЧеки();
	ЗначениеВРеквизитФормы(Обработка, "Объект");

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройки()

	Настройки = Новый Структура(
		"АдресСервера, КлючAPI, Организация, Склад, ГруппаНоменклатуры, ВидНоменклатуры,
		|СоздаватьНоменклатуру, ПропускатьНулевыеСтроки");
	ЗаполнитьЗначенияСвойств(Настройки, Объект);
	ХранилищеОбщихНастроек.Сохранить("ЗагрузкаЧековTelegram", "Настройки", Настройки);

КонецПроцедуры

&НаКлиенте
Процедура РезультатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтрокаРезультата = Объект.Результаты.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если СтрокаРезультата <> Неопределено И ЗначениеЗаполнено(СтрокаРезультата.Документ) Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(, СтрокаРезультата.Документ);
	КонецЕсли;

КонецПроцедуры
