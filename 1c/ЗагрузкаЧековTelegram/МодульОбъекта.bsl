// Внешняя обработка «Загрузка чеков из Telegram» - модуль объекта.
//
// Чеки (QR ofd.soliq.uz) принимает бот на сервере receipt-bot. Обработка забирает готовые
// чеки по HTTP и создает документы «Поступление товаров и услуг» (только запись, без проведения).
// Дубликат определяется по номеру чека (НомерВходящегоДокумента).
//
// Реквизиты обработки:
//   АдресСервера            Строка(200)   например http://192.168.1.10:8090
//   КлючAPI                 Строка(200)   значение API_KEY из .env сервера
//   Организация             СправочникСсылка.Организации
//   Склад                   СправочникСсылка.Склады
//   ГруппаНоменклатуры      СправочникСсылка.Номенклатура (группа для новых позиций)
//   ВидНоменклатуры         СправочникСсылка.ВидыНоменклатуры
//   СоздаватьНоменклатуру   Булево
//   ПропускатьНулевыеСтроки Булево        строки с суммой 0 (100% скидка) не переносятся
// Табличная часть Результаты:
//   НомерЧека Строка(50), Продавец Строка(200), Сумма Число(15,2),
//   Документ ДокументСсылка.ПоступлениеТоваровУслуг, Результат Строка(0)

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ЗагрузитьЧеки() Экспорт

	Если Не ЗначениеЗаполнено(АдресСервера) Или Не ЗначениеЗаполнено(КлючAPI) Тогда
		ВызватьИсключение "Не заполнены адрес сервера или ключ API";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ВызватьИсключение "Не заполнена организация";
	КонецЕсли;

	Результаты.Очистить();
	Ответ = ВыполнитьЗапрос("POST", "/api/receipts/claim?limit=100");

	Для Каждого Чек Из Ответ.receipts Цикл
		СтрокаРезультата = Результаты.Добавить();
		СтрокаРезультата.НомерЧека = Чек.check_number;
		СтрокаРезультата.Продавец = СтрокаИлиПусто(Чек.seller_name);
		СтрокаРезультата.Сумма = ЧислоИлиНоль(Чек.total);
		ИдентификаторЧека = Формат(Чек.id, "ЧГ=0");

		Попытка
			Документ = ОбработатьЧек(Чек, СтрокаРезультата);
			ВыполнитьЗапрос("POST", "/api/receipts/" + ИдентификаторЧека + "/ack",
				Новый Структура("document", Строка(Документ)));
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			СтрокаРезультата.Результат = "Ошибка: " + ТекстОшибки;
			Попытка
				// Чек вернется в очередь и придет при следующей загрузке.
				ВыполнитьЗапрос("POST", "/api/receipts/" + ИдентификаторЧека + "/fail",
					Новый Структура("error", ТекстОшибки));
			Исключение
				// Если сервер недоступен - чек вернется в очередь сам по истечении LEASE_MINUTES.
			КонецПопытки;
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СозданиеДокумента

Функция ОбработатьЧек(Чек, СтрокаРезультата)

	Существующий = НайтиПоступлениеПоНомеруЧека(Чек.check_number);
	Если ЗначениеЗаполнено(Существующий) Тогда
		СтрокаРезультата.Документ = Существующий;
		СтрокаРезультата.Результат = "Дубликат: чек уже введен";
		Возврат Существующий;
	КонецЕсли;

	ДатаЧека = ПрочитатьДатуJSON(Чек.check_date, ФорматДатыJSON.ISO);

	НачатьТранзакцию();
	Попытка
		Контрагент = НайтиИлиСоздатьКонтрагента(Чек);
		Договор = НайтиИлиСоздатьДоговор(Контрагент);

		Док = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
		Док.Заполнить(Неопределено);
		Док.Дата = ДатаЧека;
		Док.Организация = Организация;
		Если ЗначениеЗаполнено(Склад) Тогда
			Док.Склад = Склад;
		КонецЕсли;
		Док.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.Товары;
		Док.Контрагент = Контрагент;
		Док.ДоговорКонтрагента = Договор;
		Док.ЦенаВключаетНДС = Истина;
		Док.НомерВходящегоДокумента = Чек.check_number;
		Док.ДатаВходящегоДокумента = ДатаЧека;
		Док.Комментарий = СтрШаблон("Чек %1, ФМ %2, ФП %3. Telegram. %4",
			Чек.check_number, Чек.fm, Чек.fp, Чек.url);

		ВалютаРегл = Константы.ВалютаРегламентированногоУчета.Получить();
		УстановитьЕслиПусто(Док, "ВалютаДокумента", ВалютаРегл);
		УстановитьЕслиПусто(Док, "КурсВзаиморасчетов", 1);
		УстановитьЕслиПусто(Док, "КратностьВзаиморасчетов", 1);

		Для Каждого Позиция Из Чек.items Цикл
			Сумма = ЧислоИлиНоль(Позиция.sum);
			Если Сумма = 0 И ПропускатьНулевыеСтроки Тогда
				Продолжить;
			КонецЕсли;
			Количество = ЧислоИлиНоль(Позиция.qty);
			Если Количество = 0 Тогда
				Количество = 1;
			КонецЕсли;

			СтрокаТовара = Док.Товары.Добавить();
			СтрокаТовара.Номенклатура = НайтиНоменклатуру(Позиция);
			СтрокаТовара.Количество = Количество;
			СтрокаТовара.Сумма = Сумма; // сумма после скидки - как в чеке
			СтрокаТовара.Цена = Окр(Сумма / Количество, 2);
			СтрокаТовара.СтавкаНДС = СтавкаНДС(Позиция);
			СтрокаТовара.СуммаНДС = ЧислоИлиНоль(Позиция.vat_sum);
		КонецЦикла;

		Если Док.Товары.Количество() = 0 Тогда
			ВызватьИсключение "В чеке нет строк с суммой";
		КонецЕсли;

		Док.Записать(РежимЗаписиДокумента.Запись);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	СтрокаРезультата.Документ = Док.Ссылка;
	СтрокаРезультата.Результат = "Создан";
	Возврат Док.Ссылка;

КонецФункции

Функция НайтиПоступлениеПоНомеруЧека(НомерЧека)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	П.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК П
	|ГДЕ
	|	П.НомерВходящегоДокумента = &НомерЧека
	|	И НЕ П.ПометкаУдаления";
	Запрос.УстановитьПараметр("НомерЧека", НомерЧека);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

#КонецОбласти

#Область Справочники

Функция НайтиИлиСоздатьКонтрагента(Чек)

	ИНН = СтрокаИлиПусто(Чек.seller_inn);
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		ВызватьИсключение "В чеке не определен ИНН (СТИР) продавца";
	КонецЕсли;

	Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", ИНН);
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Контрагент;
	КонецЕсли;

	Наименование = СтрокаИлиПусто(Чек.seller_name);
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Наименование = "Продавец ИНН " + ИНН;
	КонецЕсли;

	Объект = Справочники.Контрагенты.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.ИНН = ИНН;
	УстановитьЕслиЕсть(Объект, "НаименованиеПолное", Наименование);
	Если Метаданные.Перечисления.Найти("ЮридическоеФизическоеЛицо") <> Неопределено Тогда
		УстановитьЕслиЕсть(Объект, "ЮридическоеФизическоеЛицо",
			Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо);
	КонецЕсли;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция НайтиИлиСоздатьДоговор(Контрагент)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Д.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Д
	|ГДЕ
	|	Д.Владелец = &Контрагент
	|	И Д.Организация = &Организация
	|	И Д.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком)
	|	И НЕ Д.ПометкаУдаления";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Объект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	Объект.Владелец = Контрагент;
	Объект.Организация = Организация;
	Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
	Объект.Наименование = "Покупки по корпоративной карте";
	УстановитьЕслиЕсть(Объект, "ВалютаВзаиморасчетов", Константы.ВалютаРегламентированногоУчета.Получить());
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция НайтиНоменклатуру(Позиция)

	Наименование = СокрЛП(СтрокаИлиПусто(Позиция.name));
	МХИК = СтрокаИлиПусто(Позиция.mxik);
	РеквизитМХИК = ИмяРеквизитаМХИК();

	Если ЗначениеЗаполнено(МХИК) И ЗначениеЗаполнено(РеквизитМХИК) Тогда
		Найденная = Справочники.Номенклатура.НайтиПоРеквизиту(РеквизитМХИК, МХИК);
		Если ЗначениеЗаполнено(Найденная) Тогда
			Возврат Найденная;
		КонецЕсли;
	КонецЕсли;

	Найденная = Справочники.Номенклатура.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Найденная) Тогда
		Возврат Найденная;
	КонецЕсли;

	Если Не СоздаватьНоменклатуру Тогда
		ВызватьИсключение "Не найдена номенклатура: " + Наименование
			+ ?(ЗначениеЗаполнено(МХИК), " (МХИК " + МХИК + ")", "");
	КонецЕсли;

	Объект = Справочники.Номенклатура.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	УстановитьЕслиЕсть(Объект, "НаименованиеПолное", Наименование);
	Если ЗначениеЗаполнено(ГруппаНоменклатуры) Тогда
		Объект.Родитель = ГруппаНоменклатуры;
	КонецЕсли;
	Если ЗначениеЗаполнено(ВидНоменклатуры) Тогда
		УстановитьЕслиЕсть(Объект, "ВидНоменклатуры", ВидНоменклатуры);
	КонецЕсли;
	Если ЗначениеЗаполнено(МХИК) И ЗначениеЗаполнено(РеквизитМХИК) Тогда
		Объект[РеквизитМХИК] = МХИК;
	КонецЕсли;
	ИмяЕдиницы = ?(СтрНайти(НРег(Наименование), ", kg") > 0 Или СтрНайти(НРег(Наименование), ", кг") > 0,
		"кг", "шт");
	Единица = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию(ИмяЕдиницы, Истина);
	Если ЗначениеЗаполнено(Единица) Тогда
		УстановитьЕслиЕсть(Объект, "ЕдиницаИзмерения", Единица);
	КонецЕсли;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

// Имя реквизита справочника Номенклатура с кодом МХИК (ИКПУ). Если в конфигурации
// реквизит называется иначе - добавьте его имя в список.
Функция ИмяРеквизитаМХИК()

	Для Каждого Имя Из СтрРазделить("КодИКПУ,ИКПУ,КодМХИК,МХИК,КодТНВЭД_ИКПУ", ",") Цикл
		Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция СтавкаНДС(Позиция)

	СуммаНДС = ЧислоИлиНоль(Позиция.vat_sum);
	Процент = Позиция.vat_rate;
	Если Процент = Неопределено И СуммаНДС <> 0 Тогда
		// Ставка не указана - вычисляем: НДС / (Сумма - НДС) * 100.
		База = ЧислоИлиНоль(Позиция.sum) - СуммаНДС;
		Процент = ?(База = 0, 0, Окр(СуммаНДС * 100 / База, 0));
	КонецЕсли;

	Если СуммаНДС = 0 И ЧислоИлиНоль(Процент) = 0 Тогда
		Имя = "БезНДС";
	Иначе
		Имя = "НДС" + Формат(Процент, "ЧГ=0; ЧН=0");
	КонецЕсли;

	МетаСтавки = Метаданные.Перечисления.Найти("СтавкиНДС");
	Если МетаСтавки = Неопределено Или МетаСтавки.ЗначенияПеречисления.Найти(Имя) = Неопределено Тогда
		ВызватьИсключение "Не найдена ставка НДС: " + Имя + " (Перечисление.СтавкиНДС)";
	КонецЕсли;
	Возврат Перечисления.СтавкиНДС[Имя];

КонецФункции

#КонецОбласти

#Область HTTP

Функция ВыполнитьЗапрос(Метод, Ресурс, Тело = Неопределено)

	Адрес = СокрЛП(АдресСервера);
	Защищенное = СтрНачинаетсяС(НРег(Адрес), "https://");
	Если СтрНайти(Адрес, "://") > 0 Тогда
		Адрес = Сред(Адрес, СтрНайти(Адрес, "://") + 3);
	КонецЕсли;
	Если СтрЗаканчиваетсяНа(Адрес, "/") Тогда
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЕсли;

	Префикс = "";
	ПозицияПути = СтрНайти(Адрес, "/");
	Если ПозицияПути > 0 Тогда
		Префикс = Сред(Адрес, ПозицияПути);
		Адрес = Лев(Адрес, ПозицияПути - 1);
	КонецЕсли;

	Хост = Адрес;
	Порт = Неопределено;
	ПозицияПорта = СтрНайти(Адрес, ":");
	Если ПозицияПорта > 0 Тогда
		Хост = Лев(Адрес, ПозицияПорта - 1);
		Порт = Число(Сред(Адрес, ПозицияПорта + 1));
	КонецЕсли;

	SSL = ?(Защищенное, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено);
	Соединение = Новый HTTPСоединение(Хост, Порт, , , , 60, SSL);

	Запрос = Новый HTTPЗапрос(Префикс + Ресурс);
	Запрос.Заголовки.Вставить("X-API-Key", КлючAPI);
	Если Тело <> Неопределено Тогда
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		ЗаписатьJSON(Запись, Тело);
		Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8,
			ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
	ТекстОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон("Сервер чеков вернул %1: %2", Ответ.КодСостояния, ТекстОтвета);
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстОтвета);
	Возврат ПрочитатьJSON(Чтение);

КонецФункции

#КонецОбласти

#Область Служебные

Процедура УстановитьЕслиЕсть(Объект, ИмяРеквизита, Значение)

	Если Объект.Метаданные().Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		Объект[ИмяРеквизита] = Значение;
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьЕслиПусто(Объект, ИмяРеквизита, Значение)

	Если Объект.Метаданные().Реквизиты.Найти(ИмяРеквизита) <> Неопределено
		И Не ЗначениеЗаполнено(Объект[ИмяРеквизита]) Тогда
		Объект[ИмяРеквизита] = Значение;
	КонецЕсли;

КонецПроцедуры

Функция СтрокаИлиПусто(Значение)
	Возврат ?(Значение = Неопределено, "", Строка(Значение));
КонецФункции

Функция ЧислоИлиНоль(Значение)
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);
КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
